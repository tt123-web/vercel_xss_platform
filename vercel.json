{
  "version": 2,
  "builds": [
    { "src": "**/*.php", "use": "vercel-php@0.7.3" }
  ],
  "routes": [
    { "src": "^/(.*\\.php)$", "dest": "/$1" },
    { "src": "^/api(?:/(.*))?$", "dest": "/api/index.php?a=$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(config\\.php|config-sample\\.php|.*\\.(desc|dat|log|pid))",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
